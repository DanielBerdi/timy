# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Required when running behind a proxy / on a custom host
# AUTH_URL=https://timy.example.com
# AUTH_TRUST_HOST=true

# Only this Google account may sign in
ALLOWED_EMAIL=danielberdy@gmail.com
# Timezone used when importing Google Calendar events
APP_TIMEZONE=Asia/Jerusalem
# Database (Turso/libSQL). Leave empty locally to use ./data/timy.db
# TURSO_DATABASE_URL=libsql://timy-<you>.turso.io
# TURSO_AUTH_TOKEN=
